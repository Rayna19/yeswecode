"from dotenv import load_dotenv
from pathlib import Path

ROOT_DIR = Path(__file__). parent
load_dotenv(ROOT_DIR / \".env\")

import os
import uuid
import logging
import secrets
from datetime import datetime, timezone, timedelta
from typing import List, Optional, Literal

import bcrypt
import jwt
import httpx
from fastapi import FastAPI, APIRouter, HTTPException, Request, Response, Depends, status
from starlette.middleware.cors import CORSMiddleware
from motor.motor_asyncio import AsyncIOMotorClient
from pydantic import BaseModel, Field, EmailStr

# -- DB ---
mongo_url = os.environ[\"MONGO_URL\"]
client = AsyncIOMotorClient(mongo_url)
db = client[os.environ[\"DB_NAME\"]]

# --- App ---
app = FastAPI(title=\"YesWeCode Platform API\")
api = APIRouter(prefix=\"/api\")

JNT_ALGORITHM = \"HS256\"
EMERGENT_SESSION_URL = \"https://demobackend.emergentagent.com/auth/v1/env/oauth/session-data\"

def jwt_secret() -> str:
  return os.environ[\"JWT_SECRET\"]

  # -- helpers ---
  def hash_password(pw: str) -> str:
    return bcrypt.hashpw(pw.encode(\"utf-8\"), bycrypt.gensalt()).decode(\"utf-8\")

  def verify_password(pw: str, hashed: str) -> bool:
    try:
      return bcrypt.checkpw(pw.encode(\"utf-8\"), hashed.encode(\"utf-8\"))
    except Exception:
        return False
        def create_access_token(user_id: str, email: str) -> str:
    payload = {
        \"sub\": user_id,
        \"email\": email,
        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),
        \"type\": \"access\",
    }
    return jwt.encode(payload, jwt_secret(), algorithm=JWT_ALGORITHM)


def set_auth_cookie(response: Response, token: str, key: str = \"access_token\", days: int = 7):
    response.set_cookie(
        key=key,
        value=token,
        httponly=True,
        secure=True,
        samesite=\"none\",
        max_age=days * 24 * 3600,
        path=\"/\",
    )


def clear_auth_cookies(response: Response):
    response.delete_cookie(\"access_token\", path=\"/\")
    response.delete_cookie(\"session_token\", path=\"/\")


# --- Models ---
Role = Literal[\"student\", \"instructor\", \"admin\"]


class PublicUser(BaseModel):
    user_id: str
    email: str
    name: str
    role: Role
    picture: Optional[str] = None
    onboarded: bool = False
    profile: dict = Field(default_factory=dict)
    created_at: datetime


class RegisterIn(BaseModel):
    email: EmailStr
    password: str = Field(min_length=6)
    name: str
    role: Role = \"student\"


class LoginIn(BaseModel):
    email: EmailStr
    password: str


class OnboardingIn(BaseModel):
    goal: str
    skill_level: str
    interests: List[str]
    weekly_hours: int
    preferred_time: str
    track_id: Optional[str] = None


class TrackOut(BaseModel):
    track_id: str
    title: str
    tagline: str
    color: str
    icon: str
    difficulty: str
    duration_weeks: int
    modules: List[dict]


class AvailabilityIn(BaseModel):
    date: str  # YYYY-MM-DD
    slots: List[str]  # [\"09:00\", \"10:00\", ...]


class BookingIn(BaseModel):
    instructor_id: str
    date: str
    time: str
    topic: str
    notes: Optional[str] = \"\"


# --- Auth dependency ---
async def get_current_user(request: Request) -> dict:
    user_doc = None

    # 1) JWT access_token cookie
    token = request.cookies.get(\"access_token\")
    if not token:
        auth_header = request.headers.get(\"Authorization\", \"\")
        if auth_header.startswith(\"Bearer \"):
            token = auth_header[7:]

    if token:
        try:
            payload = jwt.decode(token, jwt_secret(), algorithms=[JWT_ALGORITHM])
            if payload.get(\"type\") == \"access\":
                user_doc = await db.users.find_one(
                    {\"user_id\": payload[\"sub\"]}, {\"_id\": 0, \"password_hash\": 0}
                )
        except jwt.PyJWTError:
            user_doc = None

    # 2) Emergent session_token cookie
    if not user_doc:
        sess_token = request.cookies.get(\"session_token\")
        if sess_token:
            sess = await db.user_sessions.find_one({\"session_token\": sess_token}, {\"_id\": 0})
            if sess:
                exp = sess.get(\"expires_at\")
                if isinstance(exp, str):
                    exp = datetime.fromisoformat(exp)
                if exp and exp.tzinfo is None:
                    exp = exp.replace(tzinfo=timezone.utc)
                if exp and exp >= datetime.now(timezone.utc):
                    user_doc = await db.users.find_one(
                        {\"user_id\": sess[\"user_id\"]}, {\"_id\": 0, \"password_hash\": 0}
                    )

    if not user_doc:
        raise HTTPException(status_code=401, detail=\"Not authenticated\")
    return user_doc


def require_roles(*roles: str):
    async def _dep(user: dict = Depends(get_current_user)):
        if user.get(\"role\") not in roles:
            raise HTTPException(status_code=403, detail=\"Forbidden\")
        return user

    return _dep


# --- Auth Routes ---
@api.post(\"/auth/register\")
async def register(payload: RegisterIn, response: Response):
    email = payload.email.lower().strip()
    existing = await db.users.find_one({\"email\": email})
    if existing:
        raise HTTPException(status_code=400, detail=\"Email already registered\")
    user_id = f\"user_{uuid.uuid4().hex[:12]}\"
    user = {
        \"user_id\": user_id,
        \"email\": email,
        \"name\": payload.name,
        \"role\": payload.role,
        \"password_hash\": hash_password(payload.password),
        \"picture\": None,
        \"onboarded\": False,
        \"profile\": {},
        \"created_at\": datetime.now(timezone.utc),
    }
    await db.users.insert_one(user)
    token = create_access_token(user_id, email)
    set_auth_cookie(response, token, \"access_token\")
    out = {k: v for k, v in user.items() if k != \"password_hash\"}
    return out


@api.post(\"/auth/login\")
async def login(payload: LoginIn, response: Response):
    email = payload.email.lower().strip()
    user = await db.users.find_one({\"email\": email})
    if not user or not user.get(\"password_hash\") or not verify_password(payload.password, user[\"password_hash\"]):
        raise HTTPException(status_code=401, detail=\"Invalid email or password\")
    token = create_access_token(user[\"user_id\"], email)
    set_auth_cookie(response, token, \"access_token\")
    user.pop(\"_id\", None)
    user.pop(\"password_hash\", None)
    return user


@api.post(\"/auth/logout\")
async def logout(response: Response, request: Request):
    sess_token = request.cookies.get(\"session_token\")
    if sess_token:
        await db.user_sessions.delete_one({\"session_token\": sess_token})
    clear_auth_cookies(response)
    return {\"ok\": True}


@api.get(\"/auth/me\")
async def me(user: dict = Depends(get_current_user)):
    return user


@api.post(\"/auth/session\")
async def emergent_session(request: Request, response: Response):
    body = await request.json()
    session_id = body.get(\"session_id\")
    if not session_id:
        raise HTTPException(status_code=400, detail=\"session_id required\")
    async with httpx.AsyncClient(timeout=15) as cli:
        r = await cli.get(EMERGENT_SESSION_URL, headers={\"X-Session-ID\": session_id})
    if r.status_code != 200:
        raise HTTPException(status_code=401, detail=\"Invalid session_id\")
    data = r.json()
    email = data[\"email\"].lower().strip()
    name = data.get(\"name\") or email.split(\"@\")[0]
    picture = data.get(\"picture\")
    session_token = data[\"session_token\"]

    user = await db.users.find_one({\"email\": email}, {\"_id\": 0})
    if not user:
        user_id = f\"user_{uuid.uuid4().hex[:12]}\"
        user = {
            \"user_id\": user_id,
            \"email\": email,
            \"name\": name,
            \"role\": \"student\",
            \"picture\": picture,
            \"onboarded\": False,
            \"profile\": {},
            \"created_at\": datetime.now(timezone.utc),
        }
        await db.users.insert_one(user.copy())
    else:
        await db.users.update_one(
            {\"email\": email}, {\"$set\": {\"name\": name, \"picture\": picture}}
        )
        user[\"name\"] = name
        user[\"picture\"] = picture

    expires_at = datetime.now(timezone.utc) + timedelta(days=7)
    await db.user_sessions.insert_one(
        {
            \"session_token\": session_token,
            \"user_id\": user[\"user_id\"],
            \"expires_at\": expires_at,
            \"created_at\": datetime.now(timezone.utc),
        }
    )
    response.set_cookie(
        key=\"session_token\",
        value=session_token,
        httponly=True,
        secure=True,
        samesite=\"none\",
        max_age=7 * 24 * 3600,
        path=\"/\",
    )
    user.pop(\"password_hash\", None)
    return user


# --- Onboarding ---
@api.post(\"/onboarding\")
async def onboarding(payload: OnboardingIn, user: dict = Depends(get_current_user)):
    profile = payload.model_dump()
    await db.users.update_one(
        {\"user_id\": user[\"user_id\"]},
        {\"$set\": {\"profile\": profile, \"onboarded\": True}},
    )
    if payload.track_id:
        existing = await db.enrollments.find_one(
            {\"user_id\": user[\"user_id\"], \"track_id\": payload.track_id}, {\"_id\": 0}
        )
        if not existing:
            await db.enrollments.insert_one(
                {
                    \"enrollment_id\": f\"enr_{uuid.uuid4().hex[:10]}\",
                    \"user_id\": user[\"user_id\"],
                    \"track_id\": payload.track_id,
                    \"completed_modules\": [],
                    \"created_at\": datetime.now(timezone.utc),
                }
            )
    return {\"ok\": True}


# --- Tracks ---
@api.get(\"/tracks\", response_model=List[TrackOut])
async def list_tracks():
    items = await db.tracks.find({}, {\"_id\": 0}).to_list(100)
    return items


@api.get(\"/tracks/{track_id}\")
async def get_track(track_id: str):
    t = await db.tracks.find_one({\"track_id\": track_id}, {\"_id\": 0})
    if not t:
        raise HTTPException(404, \"Track not found\")
    return t


@api.get(\"/enrollments/me\")
async def my_enrollments(user: dict = Depends(get_current_user)):
    rows = await db.enrollments.find({\"user_id\": user[\"user_id\"]}, {\"_id\": 0}).to_list(100)
    return rows


@api.post(\"/enrollments/{track_id}\")
async def enroll(track_id: str, user: dict = Depends(get_current_user)):
    t = await db.tracks.find_one({\"track_id\": track_id}, {\"_id\": 0})
    if not t:
        raise HTTPException(404, \"Track not found\")
    existing = await db.enrollments.find_one(
        {\"user_id\": user[\"user_id\"], \"track_id\": track_id}, {\"_id\": 0}
    )
    if existing:
        return existing
    enr = {
        \"enrollment_id\": f\"enr_{uuid.uuid4().hex[:10]}\",
        \"user_id\": user[\"user_id\"],
        \"track_id\": track_id,
        \"completed_modules\": [],
        \"created_at\": datetime.now(timezone.utc),
    }
    await db.enrollments.insert_one(enr.copy())
    enr.pop(\"_id\", None)
    return enr


@api.post(\"/enrollments/{track_id}/complete/{module_id}\")
async def complete_module(track_id: str, module_id: str, user: dict = Depends(get_current_user)):
    await db.enrollments.update_one(
        {\"user_id\": user[\"user_id\"], \"track_id\": track_id},
        {\"$addToSet\": {\"completed_modules\": module_id}},
    )
    return {\"ok\": True}


# --- Instructors / Availability ---
@api.get(\"/instructors\")
async def list_instructors():
    rows = await db.users.find(
        {\"role\": \"instructor\"}, {\"_id\": 0, \"password_hash\": 0}
    ).to_list(100)
    return rows


@api.get(\"/availability/{instructor_id}\")
async def get_availability(instructor_id: str):
    rows = await db.availability.find({\"instructor_id\": instructor_id}, {\"_id\": 0}).to_list(200)
    booked = await db.sessions.find(
        {\"instructor_id\": instructor_id, \"status\": {\"$ne\": \"cancelled\"}}, {\"_id\": 0}
    ).to_list(500)
    booked_set = {f\"{b['date']} {b['time']}\" for b in booked}
    out = []
    for r in rows:
        free = [s for s in r[\"slots\"] if f\"{r['date']} {s}\" not in booked_set]
        out.append({\"date\": r[\"date\"], \"slots\": free})
    return out


@api.post(\"/availability\")
async def set_availability(payload: AvailabilityIn, user: dict = Depends(require_roles(\"instructor\"))):
    await db.availability.update_one(
        {\"instructor_id\": user[\"user_id\"], \"date\": payload.date},
        {\"$set\": {\"slots\": payload.slots}},
        upsert=True,
    )
    return {\"ok\": True}


@api.get(\"/availability/instructor/me\")
async def my_availability(user: dict = Depends(require_roles(\"instructor\"))):
    rows = await db.availability.find({\"instructor_id\": user[\"user_id\"]}, {\"_id\": 0}).to_list(200)
    return rows


# --- Sessions (bookings) ---
def make_video_link(session_id: str) -> str:
    return f\"https://meet.yeswecode.org/room/{session_id}\"


@api.post(\"/sessions\")
async def book_session(payload: BookingIn, user: dict = Depends(get_current_user)):
    instr = await db.users.find_one(
        {\"user_id\": payload.instructor_id, \"role\": \"instructor\"}, {\"_id\": 0}
    )
    if not instr:
        raise HTTPException(404, \"Instructor not found\")

    # check slot exists in availability and not already booked
    av = await db.availability.find_one(
        {\"instructor_id\": payload.instructor_id, \"date\": payload.date}, {\"_id\": 0}
    )
    if not av or payload.time not in av.get(\"slots\", []):
        raise HTTPException(400, \"Slot not available\")
    conflict = await db.sessions.find_one(
        {
            \"instructor_id\": payload.instructor_id,
            \"date\": payload.date,
            \"time\": payload.time,
            \"status\": {\"$ne\": \"cancelled\"},
        },
        {\"_id\": 0},
    )
    if conflict:
        raise HTTPException(400, \"Slot already booked\")

    session_id = f\"sess_{uuid.uuid4().hex[:10]}\"
    doc = {
        \"session_id\": session_id,
        \"student_id\": user[\"user_id\"],
        \"student_name\": user[\"name\"],
        \"instructor_id\": payload.instructor_id,
        \"instructor_name\": instr[\"name\"],
        \"date\": payload.date,
        \"time\": payload.time,
        \"topic\": payload.topic,
        \"notes\": payload.notes or \"\",
        \"status\": \"scheduled\",
        \"video_link\": make_video_link(session_id),
        \"created_at\": datetime.now(timezone.utc),
    }
    await db.sessions.insert_one(doc.copy())
    doc.pop(\"_id\", None)
    return doc


@api.get(\"/sessions/me\")
async def my_sessions(user: dict = Depends(get_current_user)):
    if user[\"role\"] == \"instructor\":
        rows = await db.sessions.find({\"instructor_id\": user[\"user_id\"]}, {\"_id\": 0}).to_list(500)
    else:
        rows = await db.sessions.find({\"student_id\": user[\"user_id\"]}, {\"_id\": 0}).to_list(500)
    rows.sort(key=lambda r: (r[\"date\"], r[\"time\"]))
    return rows


@api.post(\"/sessions/{session_id}/cancel\")
async def cancel_session(session_id: str, user: dict = Depends(get_current_user)):
    sess = await db.sessions.find_one({\"session_id\": session_id}, {\"_id\": 0})
    if not sess:
        raise HTTPException(404, \"Not found\")
    if user[\"user_id\"] not in (sess[\"student_id\"], sess[\"instructor_id\"]) and user[\"role\"] != \"admin\":
        raise HTTPException(403, \"Forbidden\")
    await db.sessions.update_one({\"session_id\": session_id}, {\"$set\": {\"status\": \"cancelled\"}})
    return {\"ok\": True}


@api.post(\"/sessions/{session_id}/complete\")
async def complete_session(session_id: str, user: dict = Depends(require_roles(\"instructor\", \"admin\"))):
    await db.sessions.update_one({\"session_id\": session_id}, {\"$set\": {\"status\": \"completed\"}})
    return {\"ok\": True}


# --- Admin ---
@api.get(\"/admin/stats\")
async def admin_stats(user: dict = Depends(require_roles(\"admin\"))):
    students = await db.users.count_documents({\"role\": \"student\"})
    instructors = await db.users.count_documents({\"role\": \"instructor\"})
    sessions = await db.sessions.count_documents({})
    completed = await db.sessions.count_documents({\"status\": \"completed\"})
    tracks = await db.tracks.count_documents({})
    enrollments = await db.enrollments.count_documents({})
    return {
        \"students\": students,
        \"instructors\": instructors,
        \"sessions\": sessions,
        \"completed_sessions\": completed,
        \"tracks\": tracks,
        \"enrollments\": enrollments,
    }


@api.get(\"/admin/users\")
async def admin_users(user: dict = Depends(require_roles(\"admin\"))):
    rows = await db.users.find({}, {\"_id\": 0, \"password_hash\": 0}).to_list(500)
    return rows


@api.get(\"/admin/sessions\")
async def admin_sessions(user: dict = Depends(require_roles(\"admin\"))):
    rows = await db.sessions.find({}, {\"_id\": 0}).to_list(500)
    rows.sort(key=lambda r: (r[\"date\"], r[\"time\"]), reverse=True)
    return rows


